# API key for the OpenAI-compatible backend (OPENAI_API_BASE_URL in docker-compose.yml)
OPENAI_API_KEY=CHANGE_ME
# Session signing key (generate with: openssl rand -hex 32)
WEBUI_SECRET_KEY=CHANGE_ME
# Cloudflare tunnel UUID; its credentials JSON lives in /etc/cloudflared (not in this repo)
CLOUDFLARE_TUNNEL_ID=CHANGE_ME
