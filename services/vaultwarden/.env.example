# --- docker-compose.yml (.env next to the compose file) ---
# Pin a release tag, e.g. 1.34.3
VAULTWARDEN_VERSION=CHANGE_ME
# Public URL = Tailscale MagicDNS name of the LXC
DOMAIN=https://CHANGE_ME.ts.net
SIGNUPS_ALLOWED=false
# Certificate + key written to /vw-data by bin/tailscale-cert-renew.sh (= /data in the container)
ROCKET_TLS='{certs="/data/tailscale.crt",key="/data/tailscale.key"}'

# --- tailscale-cert-renew.service (installed as /etc/tailscale-cert-renew.env) ---
# MagicDNS name without scheme, e.g. vaultwarden.<tailnet>.ts.net
TS_CERT_DOMAIN=CHANGE_ME
